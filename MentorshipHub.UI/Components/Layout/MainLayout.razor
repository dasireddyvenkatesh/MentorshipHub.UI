@using MentorshipHub.UI.BusinessLayer.Interfaces.Auth
@using MudBlazor
@inherits LayoutComponentBase
@inject IAuthService AuthService;

<MudThemeProvider Theme="_customTheme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.ExtraSmall"
                   CloseButton="true"
                   BackdropClick="false"
                   NoHeader="true"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true"
                   BackgroundClass="my-custom-class"/>
<MudSnackbarProvider />
<MudMainContent Class="pt-0 mt-0">
        @Body
</MudMainContent>


@code {
    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0f2942",      // Navy Blue for the Sign Up button
            AppbarBackground = "#ffffff", // Pure white header background
            Surface = "#ffffff",
            TextPrimary = "#0f2942",
        }
    };

    private static bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        _initialized = true;

        await AuthService.InitializeAsync();
    }
}