@page "/"
@using MentorshipHub.UI.Wrappers.HomePageWrapper
@using MudBlazor


@code {
    DateTime offerEnd = DateTime.UtcNow.AddHours(6);
}

<AuthWrapper />
<PromoBarWrapper IsExpired="true" OfferEndsAt="@offerEnd"
                 SlotsLeft="50"
                 RegisterUrl="/register" />
<HeroContentWrapper ShowPromoChip="false" />
<WhySection />
<CareerGrowthPlatformWrapper />


<JobOpportunitiesWrapper />

<HowItWorksWrapper />

<LimitedOfferWrapper isShow="false" TargetDate="@DateTime.Now.AddDays(7)" />

<CareerGrowthProofWrapper isShow="false" />


<AnimateOnVisible>

    <CommunityStatsWrapper isShow="false" Mentors="500"
                           Members="10000"
                           JobsPosted="1000"
                           SuccessStories="250" />

</AnimateOnVisible>

<MentorsWrapper isShow="false" />

<FAQWrapper />
<Footer_Site/>



