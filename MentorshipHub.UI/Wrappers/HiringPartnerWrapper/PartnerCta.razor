@using MudBlazor
<section class="partner-cta">

    <MudContainer MaxWidth="MaxWidth.Medium" Class="cta-container">

        <MudText Typo="Typo.h3" Class="cta-title">
            Build Your Dream Team with XQARE
        </MudText>

        <MudText Typo="Typo.subtitle1" Class="cta-subtitle">
            Join companies already leveraging the XQARE ecosystem to discover and hire skilled professionals.
        </MudText>

        <div class="cta-actions">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       Class="cta-primary"
                       Href="/partner">
                Get Started
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Class="cta-secondary"
                       Href="/platform">
                Explore Platform
            </MudButton>

        </div>

    </MudContainer>

</section>